POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# 의도 파악 C안 (규칙이 못 알아들은 말만 LLM으로). 비워 두면 규칙만 사용
ANTHROPIC_API_KEY=

# 사람 목소리 안내 (Google Cloud Text-to-Speech API 키, Text-to-Speech 에만 쓰도록 제한). 비워 두면 브라우저 목소리
TTS_API_KEY=
# TTS_VOICE=ko-KR-Chirp3-HD-Charon   # 목소리 바꾸기 (기본 ko-KR-Chirp3-HD-Aoede)
# NLU_MODEL=claude-haiku-5-5   # 더 빠르고 싸게 하려면
